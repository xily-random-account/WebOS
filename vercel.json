{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/html/apps/emulator_alpine/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ]
}