{
  "id": "/?utm_source=pwa",
  "name": "WebOS",
  "short_name": "WOS",
  "description": "A literal OS in a browser in pure HTML, CSS, and JS.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/dashboard",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#121212",
  "theme_color": "#6200ee",
  "categories": ["productivity", "utilities"],
  "scope": "/",
  "display_override": ["window-controls-overlay", "minimal-ui"],
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-dash.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Desktop Dashboard view showing the task board"
    },
    {
      "src": "/screenshots/mobile-dash.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile view of the task list"
    }
  ],
  "shortcuts": [
    {
      "name": "New Task",
      "short_name": "New Task",
      "description": "Instantly create a new task item",
      "url": "/tasks/new",
      "icons": [{ "src": "/icons/shortcut-new.png", "sizes": "96x96" }]
    },
    {
      "name": "View Calendar",
      "short_name": "Calendar",
      "description": "Check your schedule for today",
      "url": "/calendar",
      "icons": [{ "src": "/icons/shortcut-cal.png", "sizes": "96x96" }]
    }
  ],
  "share_target": {
    "action": "/share-receiver",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "attachments",
          "accept": ["image/*", "application/pdf"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "text/markdown": [".dex", ".os"]
      }
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://google.com",
      "id": "com.example.supertasker"
    }
  ],
  "prefer_related_applications": false
}
